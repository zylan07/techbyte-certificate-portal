# =================================================================
# TECHBYTE SUMMIT '26 - CERTIFICATE AUTOMATION PORTAL
# Environment Configuration Template
#
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Populate the required SMTP credentials below.
# 3. IMPORTANT: Never commit the real '.env' file to Git.
# =================================================================

# SMTP Mail Server Configuration (Gmail default)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_gmail_address@gmail.com
SMTP_FROM_NAME=Techbyte Summit '26
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Simulation Mode:
# When set to true, email dispatch simulates delivery without contacting SMTP.
# Set to false in production to send real emails with attached PDF certificates.
EMAIL_DRY_RUN=false

# Frontend API Base URL (optional - leave empty or /api for unified production serving)
# VITE_API_BASE_URL=http://localhost:8000/api
